---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

// Read the home.md file directly
const homePath = join(process.cwd(), 'src', 'content', 'pages', 'home.md');
const homeContent = readFileSync(homePath, 'utf-8');

// Extract frontmatter and body
const frontmatterMatch = homeContent.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
let bodyHtml = '';
let title = 'Blake Jones';
let description = 'Colorist, Consultant, Instructor and Writer';

if (frontmatterMatch) {
  const frontmatter = frontmatterMatch[1];
  const body = frontmatterMatch[2];
  
  // Parse frontmatter
  const titleMatch = frontmatter.match(/title:\s*"([^"]+)"/);
  const descMatch = frontmatter.match(/description:\s*"([^"]+)"/);
  if (titleMatch) title = titleMatch[1];
  if (descMatch) description = descMatch[1];
  
  // Convert body to HTML
  bodyHtml = body
    // Convert markdown images to HTML
    .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" style="max-width:100%;height:auto;border-radius:8px;margin:1.5rem 0;display:block;" />')
    // Convert markdown links to HTML
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" style="color:rgb(var(--accent-light));text-decoration:underline;">$1</a>')
    // Convert bold text
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    // Convert italic text
    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
    // Convert YouTube URLs to iframes
    .replace(/https:\/\/youtu\.be\/([a-zA-Z0-9_-]+)/g, '<iframe width="560" height="315" src="https://www.youtube.com/embed/$1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="max-width:100%;border-radius:8px;margin:1.5rem 0;display:block;"></iframe>')
    // Fix internal links that point to old WordPress site
    .replace(/href="https:\/\/blake-jones\.com\/([^"]+)"/g, 'href="/$1"')
    .replace(/href="https:\/\/www\.blake-jones\.com\/([^"]+)"/g, 'href="/$1"')
    // Clean up HTML tags
    .replace(/ class="[^"]*"/g, '')
    .replace(/<figcaption>\s*<br\s*\/?>\s*<\/figcaption>/gi, '')
    .replace(/<br\s*\/?>/gi, '');
}
---

<Layout title={title} description={description}>
  <article style="max-width: 900px; margin: 0 auto; line-height: 1.8; font-size: 1.1rem;" set:html={bodyHtml}>
  </article>
</Layout>

<style>
  article :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
    display: block;
  }
  article :global(iframe) {
    max-width: 100%;
    border-radius: 8px;
    margin: 1.5rem 0;
    display: block;
  }
  article :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: rgb(var(--accent-light));
  }
  article :global(h1) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  article :global(h3), article :global(h4) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: rgb(var(--accent-light));
  }
  article :global(p) {
    margin-bottom: 1.2rem;
  }
  article :global(hr) {
    border: none;
    border-top: 1px solid rgba(var(--accent-light), 0.3);
    margin: 2rem 0;
  }
  article :global(a) {
    color: rgb(var(--accent-light));
    text-decoration: underline;
  }
  article :global(ul), article :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }
  article :global(li) {
    margin-bottom: 0.5rem;
  }
  article :global(figure) {
    margin: 1.5rem 0;
  }
  article :global(figcaption) {
    font-size: 0.9rem;
    color: #888;
    text-align: center;
    margin-top: 0.5rem;
  }
  article :global(strong) {
    font-weight: 700;
  }
</style>
