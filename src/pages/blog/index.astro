---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<Layout title="Blog">
  <h1>Blog</h1>
  <p>Thoughts, ideas, and updates.</p>
  
  <div style="display: grid; gap: 2rem; margin-top: 2rem;">
    {sortedPosts.map((post) => (
      <article style="border: 1px solid rgba(var(--accent-light), 0.2); padding: 1.5rem; border-radius: 8px;">
        <h2>
          <a href={`/blog/${post.slug}`} style="color: rgb(var(--accent-light)); text-decoration: none;">
            {post.data.title}
          </a>
        </h2>
        <p style="color: #888; font-size: 0.9rem;">
          {new Date(post.data.pubDate).toLocaleDateString()} • {post.data.author}
        </p>
        <p>{post.data.description}</p>
        <a href={`/blog/${post.slug}`} style="color: rgb(var(--accent-light));">Read more →</a>
      </article>
    ))}
  </div>
</Layout>
